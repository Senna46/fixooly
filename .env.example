# ============================================================
# Fixooly Configuration
# ============================================================

# GitHub App ID (required)
# Obtain from your GitHub App settings page
AUTOFIX_APP_ID=

# GitHub App Private Key (one of these is required)
# Path to a .pem file downloaded from your GitHub App settings
AUTOFIX_PRIVATE_KEY_PATH=
# Or set the key content directly (useful in Docker/CI)
# AUTOFIX_PRIVATE_KEY=

# Classic PAT for git push (optional, recommended)
# Required to trigger webhook events (e.g. Cursor Bugbot review) on push.
# GitHub App installation tokens do not trigger webhooks by design.
# Create at: https://github.com/settings/tokens (classic, repo scope)
AUTOFIX_PUSH_TOKEN=

# Polling interval in seconds (default: 120)
AUTOFIX_POLL_INTERVAL=120

# Working directory for cloned repos (default: ~/.fixooly/repos)
AUTOFIX_WORK_DIR=

# SQLite database path (default: ~/.fixooly/state.db)
AUTOFIX_DB_PATH=

# Claude model override (optional, uses the CLI default if empty).
# Use the alias opus to track the latest Opus release. A full model id
# pins one version and stays there after a newer Opus ships.
AUTOFIX_CLAUDE_MODEL=

# Claude Code effort for each fix run (optional).
# One of: low, medium, high, xhigh, max. Empty keeps the CLI/user default.
# max is the deepest reasoning level the CLI accepts.
AUTOFIX_CLAUDE_EFFORT=

# Timeout for one claude -p fix run, in seconds (default: 600).
# Raise this when AUTOFIX_CLAUDE_EFFORT is xhigh or max.
AUTOFIX_CLAUDE_TIMEOUT_SECONDS=600

# Log level: debug, info, warn, error (default: info)
AUTOFIX_LOG_LEVEL=info

# ============================================================
# AI Authentication
# ============================================================

# Claude Code OAuth token (required on macOS Docker)
# Generate with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Or use Anthropic API key for pay-as-you-go
ANTHROPIC_API_KEY=
